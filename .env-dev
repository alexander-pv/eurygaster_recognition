### Networking
SUBNET=172.55.0.0
GATEWAY=172.55.0.1
MASK=16

### Inference backend
SVC_TAG=vwunhra6msmmmryc-cpu
SVC_INFERENCE_SERVER_ADDRESS=https://eurygaster.ru/api-inference

### Web server V2
WEBPAGE_TAG=0.2.1
WEBPAGE_IPV4=172.55.0.15

# Entries server
ENTRIES_TAG=0.0.2
ENTRIES_PORT=8884
ENTRIES_SERVER_ADDRESS=https://eurygaster.ru/api-entries

### Queue handler
QUEUE_HANDLER_TAG=0.0.6

### Msg broker
RMQ_TAG=3.8.34-management-alpine
RMQ_USER=user
RMQ_PWD=password
RMQ_ADDR=amqp://user:password@rabbitmq:5672
RMQ_TOPIC=NewImages

#### Supported image storage channels
### MinIO storage
MINIO_ADDR=http://minio:9000
MINIO_USER=user
MINIO_PASSWORD=password
### Telegram storage
TG_BOT_TOKEN=
TG_GROUP_ID=

### Authentication
AUTH_URL=https://identity.eurygaster.ru # Place into /etc/hosts for local tests
AUTH_REALM=eurygaster-svc
AUTH_CLIENT_ID=eurygaster-client
