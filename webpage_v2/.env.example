# Inference Server Configuration
VITE_INFERENCE_SERVER_ADDRESS=http://127.0.0.1:3000

# Entries Server Configuration
VITE_ENTRIES_SERVER_ADDRESS=http://127.0.0.1:8884

# Binary Classification Threshold (0.0 to 1.0)
VITE_BINARY_THRESHOLD=0.5

# Keycloak Authentication Configuration (optional - if not set, authentication is disabled)
VITE_AUTH_URL=https://your-keycloak-url.com
VITE_AUTH_REALM=your-realm
VITE_AUTH_CLIENT_ID=your-client-id

# Preview Carousel Configuration
VITE_PREVIEW_N_RECENT=10
VITE_PREVIEW_ICON_SIZE=100
VITE_PREVIEW_ICON_MARGIN=10
VITE_PREVIEW_ICON_BORDER=8
VITE_PREVIEW_CAROUSEL_SPEED_SEC=10

# Recent Entries Configuration
VITE_ENTRIES_N_RECENT=5

# Error Monitoring (optional)
VITE_GLITCHTIP_DSN=
VITE_SENTRY_DSN=
VITE_GLITCHTIP_ENVIRONMENT=production
